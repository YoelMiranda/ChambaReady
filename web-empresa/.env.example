# Copia este archivo como .env.local (no se sube al repo). Solo valores públicos: Vite los
# incluye en el JavaScript que llega al navegador, así que NUNCA pongas aquí claves secretas.
#
# Si dejas vacías estas variables, la web funciona en MODO DEMO: sin login y con datos de prueba
# guardados en el navegador. Con todas completas, usa el backend real y pide iniciar sesión.

# URL de la API de ChambaReady.
VITE_API_BASE_URL=http://localhost:8080/v1/

# Configuración web de Firebase (Consola de Firebase → Configuración del proyecto → Tus apps → Web).
# Es pública por diseño; protégela restringiendo la clave a tus dominios en Google Cloud.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
