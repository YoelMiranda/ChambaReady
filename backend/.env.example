# Copia este archivo como backend/.env (está en .gitignore) para correr la API en tu computadora.
# En Heroku estas variables se definen en Settings → Config Vars. NUNCA subas valores reales al repo.

# ---------- F4: base ----------
# Cadena de conexión de Neon (Dashboard → Connect → "Pooled connection"). Ejemplo de formato:
# postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/chambaready?sslmode=require
DATABASE_URL=
# Heroku la define solo; en local usa 8080.
PORT=8080
# Conexiones simultáneas a la base (el plan gratis de Neon es chico).
DB_MAX_CONEXIONES=3
# Solo en tu computadora: acepta los encabezados X-Demo-Usuario / X-Demo-Rol. En Heroku, false o vacío.
MODO_DESARROLLO=false
# Carga una empresa y vacantes de prueba. Solo en desarrollo.
CARGAR_DATOS_DEMO=false
# Token para /v1/admin (24 caracteres como mínimo). Genera uno aleatorio, por ejemplo: openssl rand -hex 24
ADMIN_TOKEN=
# Orígenes permitidos para la web de empresa, separados por coma.
CORS_ORIGENES=http://localhost:5173

# ---------- F5: Firebase ----------
FIREBASE_PROJECT_ID=
# JSON de la cuenta de servicio, en una sola línea (Firebase → Configuración → Cuentas de servicio).
FIREBASE_CREDENCIALES_JSON=

# ---------- F6: Gemini (solo desde el backend) ----------
# Opcional: sin clave, la IA usa contenido simulado y todo funciona igual. Clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_SIMPLE=gemini-3.5-flash-lite

# F7 (archivos) y F8 (pagos) son simulados: no necesitan variables. Los archivos se guardan en la
# base de datos y los pagos son de prueba (nadie paga).
